# ATA & LTA ERP v2 Frontend Local Environment Template
# Copy this file to .env.local to customize your local development settings.

# Backend API target:
# Option 1: Point to local backend (running via 'npm run dev:staging' on port 3001)
ERP_API_BASE_URL=http://localhost:3001/v1

# Option 2: Point to remote Render staging backend
# ERP_API_BASE_URL=https://ata-lta-erp-api-staging.onrender.com/v1

# Supabase Staging Target:
VITE_SUPABASE_URL=https://tqtwkmozvhttvbdatrbc.supabase.co

# Anon Public Key from Supabase Dashboard (Project Settings -> API -> Project API keys -> anon public):
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
